{
  "_comment": "Codex only; declared by .codex-plugin/plugin.json. Claude Code reads hooks/hooks.json. commandWindows is quote-free and space-free after the fixed powershell path, because Codex wraps the whole line for cmd.exe /C (openai/codex#38168). The commandWindows payload is precompact_windows.ps1 with comment and blank lines removed, base64 of UTF-16LE; tests/win_compat.sh reproduces that transform and asserts the payload matches, so the two cannot drift.",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" stop",
            "commandWindows": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 15,
            "statusMessage": "Checking SDP precompact threshold..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" precompact",
            "commandWindows": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" resume",
            "commandWindows": "%SystemRoot%\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
