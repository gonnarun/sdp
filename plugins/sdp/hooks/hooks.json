{
  "_comment": "Claude Code only. Codex reads hooks/hooks.codex.json, declared in .codex-plugin/plugin.json. shell form with shell=bash, not exec form: exec form would spawn `bash` from PATH, which a Windows host need not have, whereas shell=bash lets Claude Code select Git Bash itself. Embedded quotes are safe here because bash parses them; only the Codex Windows runtime mis-parses them.",
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" stop",
            "timeout": 15,
            "statusMessage": "Checking SDP precompact threshold...",
            "shell": "bash"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" precompact",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/precompact_launcher.sh\" resume",
            "timeout": 10,
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
